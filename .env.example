# Base URL API PFI. Dipakai hanya di sisi server (route handler / server action),
# jadi TIDAK boleh diberi prefix NEXT_PUBLIC_.
PFI_API_BASE_URL=https://api-pfi.modoto.net

# Biner LibreOffice untuk mengubah RIPLAY (.docx) menjadi PDF. Kosongkan bila
# LibreOffice ada di lokasi bawaan sistem atau di PATH; isi kalau dipasang di
# tempat lain. Contoh Ubuntu: /usr/bin/soffice — contoh Windows:
# C:\Program Files\LibreOffice\program\soffice.com
# LIBREOFFICE_PATH=
